    "/my/{name}/action/bank/withdraw/item": { "post": { "requestBody": { "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SimpleItemSchema" } } } } } } },
    "/my/{name}/action/bank/deposit/item": { "post": { "requestBody": { "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SimpleItemSchema" } } } } } } },
    "/characters/{name}": { "get": {} }, "/maps": { "get": {} }, "/resources": { "get": {} }, "/items": { "get": {} }, "/monsters": { "get": {} },
    "/my/{name}/action/move": { "post": { "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DestinationSchema" } } } } } },
    "/my/{name}/action/gathering": { "post": {} }, "/my/{name}/action/fight": { "post": {} }, "/my/{name}/action/rest": { "post": {} },
    "/my/{name}/action/equip": { "post": { "requestBody": { "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EquipSchema" } } } } } } },
    "/my/{name}/action/unequip": { "post": { "requestBody": { "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UnequipSchema" } } } } } } },
    "/my/{name}/action/crafting": { "post": {} }
  },
  "components": { "schemas": {
