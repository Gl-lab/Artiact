<?xml version="1.0" encoding="utf-8" ?>
<!-- XSD manual extracted from package NLog.Schema: https://www.nuget.org/packages/NLog.Schema-->
<nlog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xsi:schemaLocation=""
      autoReload="true"
      internalLogFile="c:\temp\console-example-internal.log"
      internalLogLevel="Info">
    
    <extensions>
        <add assembly="NLog.DiagnosticSource"/>
    </extensions>
    
    <!-- the targets to write to -->
    <targets>
        <!-- write logs to file -->
        <target xsi:type="File" name="logfile" fileName="logs/${shortdate}.log"
                layout="${longdate}|${level}|TraceId=${activity:TraceId}|SpanId=${activity:SpanId}|${message} ${exception:format=tostring}"/>
        <target xsi:type="Console" name="logconsole"
                layout="${longdate}|${level}|TraceId=${activity:format=TraceId}|SpanId=${activity:SpanId}|${message} |${all-event-properties} ${exception:format=tostring}"/>
    </targets>

    <!-- rules to map from logger name to target -->
    <rules>
        <logger name="System.*" minlevel="Debug" writeTo="logconsole"/>
        <logger name="Artiact.*" minlevel="Debug" writeTo="logfile"/>
    </rules>
</nlog>